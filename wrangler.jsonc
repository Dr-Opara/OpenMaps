{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "openmaps-web",
  "compatibility_date": "2026-02-12",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  // Worker entry point generated by vinext (RSC/SSR fetch handler). Without this, Wrangler
  // has no Worker script to run and the deployment serves nothing but static assets (404s).
  "main": "vinext/server/fetch-handler",

  // Static client assets emitted by `vite build` (vinext). Required for CSS/JS/images.
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },

  // Production domain. Requires openmaps.tech to be an active zone in this Cloudflare account
  // (see README > Custom domain). Cloudflare creates the DNS record and certificate automatically.
  "routes": [{ "pattern": "openmaps.tech", "custom_domain": true }]

  // Secrets (NOT stored here): SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY
  //   npx wrangler secret put SUPABASE_URL
  //   npx wrangler secret put SUPABASE_SERVICE_ROLE_KEY
}
